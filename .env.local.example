# Supabase (required for Phase A+)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic Claude (required for Phase B pipeline + AI suggestions)
ANTHROPIC_API_KEY=sk-ant-...

# Voyage AI embeddings (required for Phase B clustering)
VOYAGE_API_KEY=pa-...

# G2 Partner API v2 (optional — CSV fallback used when absent)
# Auth header format: Authorization: Bearer <G2_API_KEY>
# Also requires a G2-side data subscription for the target product, or
# every request 403s even with a valid key.
G2_API_KEY=

# Optional: default G2 product id for live sync
G2_PRODUCT_ID=

# Zendesk (optional — live ticket sync; requires an OAuth Confidential
# client using the client_credentials grant, not a static API token —
# Zendesk blocks new API token creation as of 2026-07-28).
# Admin Center → Apps and integrations → APIs → OAuth clients → Add OAuth
# client → Client Kind: Confidential.
ZENDESK_SUBDOMAIN=
ZENDESK_CLIENT_ID=
ZENDESK_CLIENT_SECRET=

# Admin auth: real Supabase login (email/password), gating
# mutating/spend-triggering routes. No extra env var needed — it reuses
# NEXT_PUBLIC_SUPABASE_URL/NEXT_PUBLIC_SUPABASE_ANON_KEY above. Create the
# admin's account once via the Supabase dashboard (Authentication → Users →
# Add user) or the service-role `auth.admin.createUser()` API, then sign in
# at /login.
