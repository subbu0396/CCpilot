# Supabase (required for Phase A+)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic Claude (required for Phase B pipeline + AI suggestions)
ANTHROPIC_API_KEY=sk-ant-...

# Voyage AI embeddings (required for Phase B clustering)
VOYAGE_API_KEY=pa-...

# Zendesk (optional — live ticket sync; requires an OAuth Confidential
# client using the client_credentials grant, not a static API token —
# Zendesk blocks new API token creation as of 2026-07-28).
# Admin Center → Apps and integrations → APIs → OAuth clients → Add OAuth
# client → Client Kind: Confidential.
ZENDESK_SUBDOMAIN=
ZENDESK_CLIENT_ID=
ZENDESK_CLIENT_SECRET=

# Zendesk webhook (real-time Core Analysis Agent trigger). Generate any
# random string yourself (e.g. `openssl rand -hex 32`), set it here, and
# paste the same value into the webhook's Authentication = "Bearer token"
# field when creating it in Admin Center → Apps and integrations →
# Webhooks → Create webhook.
ZENDESK_WEBHOOK_SECRET=

# Jira (optional — auto-creates an issue when a roadmap item is dragged into
# "Now"). Create an API token at
# https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Task

# Admin auth: real Supabase login (email/password), gating
# mutating/spend-triggering routes. No extra env var needed — it reuses
# NEXT_PUBLIC_SUPABASE_URL/NEXT_PUBLIC_SUPABASE_ANON_KEY above. Create the
# admin's account once via the Supabase dashboard (Authentication → Users →
# Add user) or the service-role `auth.admin.createUser()` API, then sign in
# at /login.
