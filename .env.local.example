# Supabase (required for Phase A+)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic Claude (required for Phase B pipeline + AI suggestions)
ANTHROPIC_API_KEY=sk-ant-...

# Voyage AI embeddings (required for Phase B clustering)
VOYAGE_API_KEY=pa-...

# G2 Partner API (optional — CSV fallback used when absent)
# Auth header format: Authorization: Token token=<G2_API_KEY>
G2_API_KEY=

# Optional: default G2 product id for live sync
G2_PRODUCT_ID=

# Admin auth (required to gate mutating/spend-triggering routes)
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=
